# ==============================================================================
# AGC CMS Backend Environment Configuration Template
# Copy this file to .env and configure your secure values for production/staging
# ==============================================================================

# Server Port
SERVER_PORT=8097

# Database Connection (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agc_cms
DB_USERNAME=root
DB_PASSWORD=root
DB_URL=jdbc:mysql://127.0.0.1:3306/agc_cms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=CONVERT_TO_NULL

# JWT Authentication Secret Key (Base64-encoded or min 256-bit secure secret)
JWT_SECRET=d291bGQteW91LWxpa2UtdG8tYnVpbGQtYS1zdXBlci1zZWN1cmUtand0LXNlY3JldC1rZXktZm9yLWFnYy1jbXMtMjAyNiE=
JWT_EXPIRATION_HOURS=8

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Storage
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
